# -----------------------------------------------------------------------
# Value Bet Finder - environment variable template
#
# Copy this file to ".env" for local testing:
#     cp .env.example .env
# then fill in real values. NEVER commit the real ".env" file.
#
# On PythonAnywhere, do NOT upload a .env file for secrets - instead set
# these as real environment variables on the "Tasks" (scheduled task) page,
# or export them at the top of a small wrapper shell script that the
# scheduled task calls. See README.md for exact steps.
# -----------------------------------------------------------------------

# --- Required: The Odds API ---------------------------------------------
# Sign up for a free-tier key at https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# --- Required: Gmail SMTP -------------------------------------------------
# EMAIL_USER is the Gmail address that SENDS the mail.
# EMAIL_PASSWORD must be a 16-character Google "App Password", NOT your
# normal Gmail password. Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account).
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# Comma-separated list of recipient addresses. Defaults to EMAIL_USER
# (i.e. you email yourself the picks) if left blank.
EMAIL_TO=your_email@gmail.com

# --- Optional: paths -------------------------------------------------------
# Absolute paths are strongly recommended on PythonAnywhere, e.g.
# /home/yourusername/value_bet_finder/history.db
DATABASE_PATH=
LOG_PATH=

# --- Optional: logging -----------------------------------------------------
LOG_LEVEL=INFO

# --- Optional: leagues covered (Odds API "sport keys"), comma separated ---
SOCCER_LEAGUES=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league

# --- Optional: bookmaker regions queried on The Odds API -------------------
ODDS_REGIONS=eu,uk

# --- Optional: value engine tuning -----------------------------------------
MIN_VALUE_THRESHOLD=0.05
MAX_VALUE_THRESHOLD=0.60
MIN_MODEL_CONFIDENCE=0.02
MAX_PICKS_PER_DAY=3
MAX_PICKS_PER_MARKET=2

# --- Optional: run mode -----------------------------------------------------
# Set to true to run the full pipeline (including logging + DB writes)
# without actually sending an email. Useful for a first smoke test.
DRY_RUN=false
